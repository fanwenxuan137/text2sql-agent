# 复制本文件为 .env，填入你自己的 Key（.env 已被 .gitignore 忽略，不会上传）
# 以 DeepSeek 为例：https://platform.deepseek.com 注册后在「API keys」页面创建

LLM_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat

# ---- 备用方案（换 provider 时只改上面三行即可）----
# 硅基流动： LLM_BASE_URL=https://api.siliconflow.cn/v1   LLM_MODEL=Qwen/Qwen2.5-7B-Instruct
# 智谱：     LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4   LLM_MODEL=glm-4-flash
